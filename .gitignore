# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Outputs: run artefacts, history, SQLite DB, LLM mapping cache.
# Default dir is results/; the file names catch a custom --results dir too.
results/
history/
cache/
*.db
*.sqlite
*.sqlite3
*.log
mapping.json
score_*.json
run_*.json
summary.json

# Inputs (redflows, text, videos/PDF assets) stay local
*.redflow
*.txt
*.mp4
*.mov
*.webm
tasks/**/*.pdf
# ...except what tests and CI need: the syntax fixtures and the golden Venus task (its GT and runs are
# published in docs/redscore-spec.md anyway), and the pinned requirements.
!tests/fixtures/**/*.redflow
!tasks/venus-jml-create-account/**/*.redflow
!requirements*.txt

# claude.ai export: keep only the extracted transcripts and generated code.
# The raw export holds unrelated personal chats, account metadata and ~24MB of artifact bundles.
docs/old-chat/*
!docs/old-chat/transcripts/
!docs/old-chat/generated-files/

# OS / editor
.DS_Store
.idea/
.claude/settings.local.json
