# Copy to .env (git-ignored) and fill in. Used for the pinned mapping LLM call.
REASONING_MODEL_API_KEY=
REASONING_MODEL_NAME=redblock-visual-reasoning-2.0
REASONING_MODEL_API_BASE_URL=
# Optional: per-call timeout in seconds, and retries with exponential backoff on connection errors,
# timeouts, 429 and 5xx (a run that still fails is recorded as "not scored", never as a 0).
# REASONING_MODEL_TIMEOUT=300
# REASONING_MODEL_MAX_RETRIES=4
